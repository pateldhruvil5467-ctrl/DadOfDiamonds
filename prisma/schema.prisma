// Dad of Diamonds — Prisma schema
// See ../PLAN.md (or the project README) for the architecture this schema implements:
// snapshot-based order history, transactional/race-safe checkout, idempotent payment
// settlement, and product archival instead of hard deletes.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// Prisma 7: connection URL is no longer set here. Migrate/CLI use prisma7.config.ts;
// the runtime PrismaClient uses an explicit driver adapter — see lib/prisma.ts.
datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING // created, awaiting payment confirmation
  CONFIRMED // payment succeeded, not yet in fulfillment
  PROCESSING // being prepared/packed
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentProviderName {
  MOCK
  STRIPE
  RAZORPAY
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String? // null for OAuth-only accounts
  role         Role     @default(CUSTOMER)
  image        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts  Account[]
  sessions  Session[]
  addresses Address[]
  orders    Order[]
}

// Standard Auth.js Prisma-adapter models. With `session.strategy = "jwt"` (required because
// Credentials auth is used alongside this adapter), the Session table is kept for adapter
// compatibility but is not written to at runtime — session state lives in the signed JWT.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  description    String
  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)
  currency       String   @default("EUR")
  categoryId     String
  material       String
  sku            String   @unique
  stock          Int      @default(0)
  isFeatured     Boolean  @default(false)
  isUnisex       Boolean  @default(true)
  isActive       Boolean  @default(true) // false = archived, hidden from storefront; products are never hard-deleted
  archivedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category   Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images     ProductImage[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([isActive])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  // Local /placeholders/*.svg today; swappable to a CDN/S3/Cloudinary URL later with no
  // domain-model change, since images are their own table rather than a field on Product.
  url       String
  altText   String?
  position  Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  fullName   String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String
  phone      String
  createdAt  DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Traceability only — editing/deleting an Address never affects the immutable shipping
  // snapshot fields already stored on any Order that referenced it (see Order below).
  orders Order[]

  @@index([userId])
}

model Order {
  id       String @id @default(cuid())
  // Real Postgres sequence (Prisma autoincrement()), concurrency-safe by construction —
  // never generated via an application-level count()/max() query.
  orderSeq Int    @default(autoincrement())
  // Derived human-readable value, e.g. "DOD-2026-000123". Nullable ONLY because orderSeq's
  // value isn't known until after insert; the create+derive+update all happen inside one
  // Prisma transaction (see lib/orders/create-order.ts), so no COMMITTED row can ever have
  // orderNumber = null — if the derive/update step were skipped or failed, the whole
  // transaction (including the insert) rolls back and no row is persisted at all.
  orderNumber String? @unique

  // One idempotency key per checkout attempt. A duplicate submit with the same key resolves
  // to the same order instead of creating a second one (unique constraint is the race-proof
  // guarantee; an app-level pre-check is just a fast path).
  idempotencyKey String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  status          OrderStatus         @default(PENDING)
  paymentStatus   PaymentStatus       @default(PENDING)
  paymentProvider PaymentProviderName @default(MOCK)
  paymentReference String? // provider's charge/transaction id; null until settled
  // Settlement claim lock: set atomically (compare-and-swap) BEFORE the external payment
  // provider is ever called, so at most one concurrent/retried settlePayment() execution
  // can ever invoke the provider for a given order. See lib/payments/settle-payment.ts.
  paymentAttemptedAt DateTime?

  currency     String  @default("EUR")
  subtotal     Decimal @db.Decimal(10, 2)
  shippingCost Decimal @default(0) @db.Decimal(10, 2)
  total        Decimal @db.Decimal(10, 2)

  // Optional link back to the customer's saved address, for admin traceability only.
  addressId String?
  address   Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  // Immutable shipping snapshot captured at order placement — this, not `address`, is what
  // order confirmation, account/orders, and admin order detail always display.
  shippingFullName   String
  shippingLine1      String
  shippingLine2      String?
  shippingCity       String
  shippingState      String
  shippingPostalCode String
  shippingCountry    String
  shippingPhone      String

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  // Nullable safety net only (onDelete: SetNull) — the app-level rule is that products are
  // archived, never hard-deleted, so this should never actually need to fire in practice.
  productId String?

  // Snapshots captured at purchase time — these, not a live join to Product, are what make
  // historical orders immune to later edits/archival of the product.
  productName String
  sku         String
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int
  subtotal    Decimal @db.Decimal(10, 2)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

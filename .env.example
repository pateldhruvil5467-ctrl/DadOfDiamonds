# ---------------------------------------------------------------------------
# Runtime variables — validated by lib/env.ts. The app will not start if any
# required value here is missing or malformed.
# ---------------------------------------------------------------------------

# Neon Postgres — two connection strings from the SAME Neon project/branch, for two
# different consumers. Use a DEV-only Neon project here — never point local development at
# the same database used in production.
#
# DATABASE_URL: the POOLED connection (routed through Neon's PgBouncer; hostname typically
# contains "-pooler"). Used by the application runtime (lib/prisma.ts, via the PrismaPg
# adapter) for normal request-time queries.
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/db?sslmode=require"

# DIRECT_URL: the DIRECT / unpooled connection (no "-pooler" in the hostname). Used
# exclusively by the Prisma CLI (prisma7.config.ts) for `prisma migrate`/`prisma db seed`/
# `prisma generate` — PgBouncer's transaction-pooling mode doesn't support the advisory locks
# Prisma Migrate relies on. The running app never reads this value.
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/db?sslmode=require"

# Auth.js — generate a local dev secret with: npx auth secret
# (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
NEXTAUTH_SECRET="replace-with-a-generated-secret"
NEXTAUTH_URL="http://localhost:3000"

# Optional pair — leave BOTH unset to develop with credentials-only auth (no Google button
# will render). Set BOTH together once you have real Google OAuth credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — defaults to "mock" if unset. Only "mock" is implemented; do not set this to
# "stripe" or "razorpay" until those providers are actually implemented.
PAYMENT_PROVIDER=mock

# ---------------------------------------------------------------------------
# Seed-only variables — read ONLY by prisma/seed.ts (via `npx prisma db seed`), never by
# the running app. Do not put a real/shared password here.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
